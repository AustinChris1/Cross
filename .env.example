# Written by pnpm deploy
CROSS_ADDRESS=
VAULT_ADDRESS=

# Solver: required edge over fair value, loop period, matches scanned per tick
# SOLVER_EDGE=0.03
# SOLVER_INTERVAL_MS=6000
# SOLVER_SCAN=60

# The send switch. Leave true until you mean it; false lets the solver spend real STT.
DRY_RUN=true

# somnia_watch reactivity, on by default. false falls back to polling only.
# REACTIVE=true

# On-chain reactivity needs the reactor contract to hold 32 STT before subscribe()
# DEPLOY_REACTOR=false
